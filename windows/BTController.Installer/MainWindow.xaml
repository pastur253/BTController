<Window x:Class="BTController.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Bluetooth Controller"
        Height="420" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Установка Bluetooth Controller" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Версия для Windows 11 с виджетом мини-приложений (Win + W)" FontSize="12" Foreground="#D0E7FF" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body content -->
        <Grid Grid.Row="1" Margin="24,16,24,12">
            <!-- Configuration view -->
            <StackPanel x:Name="ConfigPanel">
                <TextBlock Text="Мастер установит Bluetooth Controller на ваш компьютер." FontSize="13" Foreground="#333333" Margin="0,0,0,16" />

                <!-- Install Directory Selection -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Папка установки:" FontWeight="SemiBold" FontSize="12" Foreground="#222222" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPath" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" />
                        <Button x:Name="BtnBrowse" Grid.Column="2" Content="Обзор..." Height="30" Click="BtnBrowse_Click" Cursor="Hand" />
                    </Grid>
                    <TextBlock Text="Вы можете выбрать любую папку или диск для установки." FontSize="11" Foreground="#666666" />
                </StackPanel>

                <!-- Options checkboxes -->
                <StackPanel Margin="0,6,0,0">
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Создать ярлык на Рабочем столе" IsChecked="True" FontSize="12" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkStartMenuShortcut" Content="Создать ярлык в меню «Пуск»" IsChecked="True" FontSize="12" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkLaunchAfter" Content="Запустить приложение после завершения установки" IsChecked="True" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <!-- Progress view -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Подготовка к установке..." FontWeight="SemiBold" FontSize="14" Foreground="#222222" Margin="0,0,0,14" />
                <ProgressBar x:Name="PrgInstall" Height="16" IsIndeterminate="True" Margin="0,0,0,14" />
                <TextBlock x:Name="TxtSubStatus" Text="Пожалуйста, подождите..." FontSize="12" Foreground="#666666" />
            </StackPanel>

            <!-- Success view -->
            <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="✓ Установка успешно завершена!" FontSize="18" FontWeight="SemiBold" Foreground="#107C10" Margin="0,0,0,10" />
                <TextBlock Text="Bluetooth Controller установлен и готов к использованию." FontSize="13" Foreground="#333333" Margin="0,0,0,6" />
                <TextBlock Text="Для быстрого доступа к виджету нажмите Win + W на клавиатуре." FontSize="12" Foreground="#666666" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#E6E6E6" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnInstall" Content="Установить" Width="100" Height="32" Click="BtnInstall_Click"
                        Background="#0078D4" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" />
                <Button x:Name="BtnFinish" Content="Готово" Width="100" Height="32" Click="BtnFinish_Click"
                        Background="#0078D4" Foreground="White" FontWeight="SemiBold" Visibility="Collapsed" Cursor="Hand" Margin="0,0,10,0" />
                <Button x:Name="BtnCancel" Content="Отмена" Width="90" Height="32" Click="BtnCancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
