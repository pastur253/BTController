<Window x:Class="BTController.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Bluetooth Controller"
        Height="360" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Установка Bluetooth Controller" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Пакет MSIX для Windows 11 с виджетом (Win + W)" FontSize="12" Foreground="#D0E7FF" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body content -->
        <Grid Grid.Row="1" Margin="24,20,24,16">
            <!-- Configuration view -->
            <StackPanel x:Name="ConfigPanel" VerticalAlignment="Center">
                <TextBlock Text="Мастер автоматически установит:" FontWeight="SemiBold" FontSize="14" Foreground="#222222" Margin="0,0,0,10" />
                <TextBlock Text="1. Сертификат подписи приложения в доверенные издатели (потребуется подтверждение UAC)."
                           FontSize="12.5" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="2. Приложение Bluetooth Controller (MSIX) и виджет для панели Win + W."
                           FontSize="12.5" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,18" />

                <CheckBox x:Name="ChkLaunchAfter" Content="Запустить приложение после завершения установки" IsChecked="True" FontSize="12.5" />
            </StackPanel>

            <!-- Progress view -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Установка..." FontWeight="SemiBold" FontSize="14" Foreground="#222222" Margin="0,0,0,14" />
                <ProgressBar x:Name="PrgInstall" Height="16" IsIndeterminate="True" Margin="0,0,0,14" />
                <TextBlock x:Name="TxtSubStatus" Text="Пожалуйста, подождите..." FontSize="12" Foreground="#666666" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Success view -->
            <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="✓ Установка успешно завершена!" FontSize="18" FontWeight="SemiBold" Foreground="#107C10" Margin="0,0,0,10" />
                <TextBlock Text="Bluetooth Controller (MSIX) установлен и готов к работе." FontSize="13" Foreground="#333333" Margin="0,0,0,6" />
                <TextBlock Text="Нажмите Win + W и добавьте виджет «Bluetooth Controller» через кнопку «+»." FontSize="12" Foreground="#666666" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#E6E6E6" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnInstall" Content="Установить" Width="110" Height="32" Click="BtnInstall_Click"
                        Background="#0078D4" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" />
                <Button x:Name="BtnFinish" Content="Готово" Width="100" Height="32" Click="BtnFinish_Click"
                        Background="#0078D4" Foreground="White" FontWeight="SemiBold" Visibility="Collapsed" Cursor="Hand" Margin="0,0,10,0" />
                <Button x:Name="BtnCancel" Content="Отмена" Width="90" Height="32" Click="BtnCancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
