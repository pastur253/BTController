<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyTitle>Bluetooth Controller Setup</AssemblyTitle>
    <ApplicationIcon>installer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BTController-Setup</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\artifacts\release\BTController-Windows-x64.msix"
                      Condition="Exists('..\artifacts\release\BTController-Windows-x64.msix')">
      <LogicalName>BTController.msix</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\artifacts\release\BTController-Windows-x64.cer"
                      Condition="Exists('..\artifacts\release\BTController-Windows-x64.cer')">
      <LogicalName>BTController.cer</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
