<Page
    x:Class="BTController.App.Views.PairedPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BTController.Core.Models">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Сопряженные устройства" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Все сохраненные Bluetooth-устройства вашего компьютера"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Command="{x:Bind ViewModel.LoadDevicesCommand}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Обновить" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Device List -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.PairedDevices}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:BluetoothDeviceModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,4,0,4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- Device Type Icon -->
                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind TypeGlyph, Mode=OneWay}"
                                      FontSize="24"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0" />

                            <!-- Device Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind Address, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Add to widget -->
                            <Button Grid.Column="2"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.AddToWidgetCommand}"
                                    CommandParameter="{x:Bind}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="В виджет" />
                                </StackPanel>
                            </Button>

                            <!-- Connect / Disconnect Action Button -->
                            <Button Grid.Column="3"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.ToggleConnectionCommand}"
                                    CommandParameter="{x:Bind}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    VerticalAlignment="Center"
                                    MinWidth="110">
                                <TextBlock Text="{x:Bind ActionButtonText, Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
