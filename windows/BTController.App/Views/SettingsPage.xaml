<Page
    x:Class="BTController.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Параметры" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Настройки приложения и интеграции с Windows 11"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Windows 11 Widgets Board Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE78B;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="Виджет Windows 11 (Мини-приложения)" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Отображение в панели виджетов (сочетание клавиш Win + W)"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Чтобы закрепить виджет:" FontWeight="Medium" Margin="0,8,0,0"/>
                    <TextBlock Text="1. Откройте панель мини-приложений Windows (нажмите Win + W или кликните по иконке погоды в левом нижнем углу панели задач)." />
                    <TextBlock Text="2. Нажмите кнопку '+' (Добавить виджеты) в правом верхнем углу панели." />
                    <TextBlock Text="3. Найдите 'Bluetooth Controller' и нажмите 'Закрепить'." />
                </StackPanel>
            </Border>

            <!-- Appearance Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Тема оформления" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Выберите оформление приложения или используйте параметры системы Windows"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ComboBox Grid.Column="1" SelectedIndex="0" MinWidth="150" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Как в системе" />
                        <ComboBoxItem Content="Светлая" />
                        <ComboBoxItem Content="Темная" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Updates Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Обновление приложения" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.CheckUpdateCommand}"
                            IsEnabled="{x:Bind ViewModel.CanCheckUpdate, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="14" />
                            <TextBlock Text="Проверить" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- About Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="О приложении" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Информация о разработчике, исходном коде и обратной связи"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <!-- Developer -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Разработчик"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.DeveloperName}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- GitHub -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="GitHub репозиторий" />
                            <TextBlock Text="Исходный код и релизы проекта"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1"
                                         Content="github.com/pastur253/BTController"
                                         NavigateUri="{x:Bind ViewModel.GitHubUrl}"
                                         VerticalAlignment="Center" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Feedback -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Обратная связь" />
                            <TextBlock Text="Создать Issue на GitHub: сообщить об ошибке или предложить новую функцию"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton Content="Сообщить об ошибке"
                                             NavigateUri="{x:Bind ViewModel.BugReportUrl}"
                                             Padding="12,6" />
                            <HyperlinkButton Content="Предложить функцию"
                                             NavigateUri="{x:Bind ViewModel.FeatureRequestUrl}"
                                             Padding="12,6" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
