<Page
    x:Class="BTController.App.Views.DiscoveryPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BTController.Core.Models">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Поиск новых устройств" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Сканирование окружающих Bluetooth-устройств в режиме обнаружения"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                              Width="20" Height="20" />
                <Button Command="{x:Bind ViewModel.StartScanCommand}"
                        Visibility="{x:Bind GetScanButtonVisibility(ViewModel.IsScanning), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="Начать поиск" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.StopScanCommand}"
                        Visibility="{x:Bind GetStopButtonVisibility(ViewModel.IsScanning), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Остановить" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Discovered Device List -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.DiscoveredDevices}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:BluetoothDeviceModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,4,0,4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE702;"
                                      FontSize="24"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="15" />
                                <TextBlock Text="{x:Bind Id, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.PairDeviceCommand}"
                                    CommandParameter="{x:Bind}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    VerticalAlignment="Center"
                                    MinWidth="120">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Сопряжение" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
