<Page
    x:Class="BTController.App.Views.DashboardPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BTController.Core.Models"
    xmlns:viewmodels="using:BTController.App.ViewModels">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Устройства в виджете" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Управляйте списком устройств, отображаемых в панели мини-приложений Windows (Win + W)"
                           Style="{ThemeResource BodySubtleTextBlockStyle}" />
            </StackPanel>
            <Button Command="{x:Bind ViewModel.LoadDevicesCommand}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Обновить" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Informational Banner -->
        <InfoBar Grid.Row="1"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="Интеграция с Windows Widgets Board"
                 Message="Виджет обновляется автоматически. Нажмите Win + W на клавиатуре для быстрого доступа."
                 Margin="0,0,0,16" />

        <!-- Device List -->
        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.WidgetDevices}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:BluetoothDeviceModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,4,0,4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- Device Type Icon -->
                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind TypeGlyph, Mode=OneWay}"
                                      FontSize="24"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0" />

                            <!-- Device Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind Address, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Up/Down Reorder Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Button Command="{Binding ElementName=RootPage, Path=ViewModel.MoveUpCommand}"
                                        CommandParameter="{x:Bind}"
                                        ToolTipService.ToolTip="Переместить выше">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                </Button>
                                <Button Command="{Binding ElementName=RootPage, Path=ViewModel.MoveDownCommand}"
                                        CommandParameter="{x:Bind}"
                                        ToolTipService.ToolTip="Переместить ниже">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                </Button>
                                <Button Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveFromWidgetCommand}"
                                        CommandParameter="{x:Bind}"
                                        ToolTipService.ToolTip="Удалить из виджета">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>

                            <!-- Connect / Disconnect Action Button -->
                            <Button Grid.Column="3"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.ToggleConnectionCommand}"
                                    CommandParameter="{x:Bind}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    VerticalAlignment="Center"
                                    MinWidth="110">
                                <TextBlock Text="{x:Bind ActionButtonText, Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
