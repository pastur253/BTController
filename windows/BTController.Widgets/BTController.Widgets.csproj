  <ItemGroup>
    <ProjectReference Include="..\BTController.Core\BTController.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
