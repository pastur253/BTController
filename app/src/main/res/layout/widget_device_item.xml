<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Device Icon -->
    <ImageView
        android:id="@+id/widget_item_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Устройство"
        android:padding="2dp"
        android:src="@drawable/ic_headphones" />

    <!-- Name and Status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Устройство"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Отключено"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Connect Action Button (Shown when disconnected) -->
    <Button
        android:id="@+id/widget_item_btn_connect"
        android:layout_width="68dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_btn_connect_bg"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/btn_connect"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <!-- Disconnect Action Button (Shown when connected) -->
    <Button
        android:id="@+id/widget_item_btn_disconnect"
        android:layout_width="68dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_btn_disconnect_bg"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/btn_disconnect"
        android:textColor="#EF4444"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Connecting In-Progress Button -->
    <Button
        android:id="@+id/widget_item_btn_connecting"
        android:layout_width="68dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_btn_disconnect_bg"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="..."
        android:textColor="#FBBF24"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
